# Porta (Railway define automaticamente, não precisa mexer em produção)
PORT=3000

# SMTP para o formulário de contato enviar e-mail (opcional no início)
# Exemplo com um provedor como Zoho, Gmail (com senha de app), SendGrid ou Resend SMTP
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-usuario-smtp
SMTP_PASS=sua-senha-smtp

# Para onde os leads do formulário devem ser enviados
CONTACT_TO_EMAIL=contato@arvoredavidaambiental.com.br
